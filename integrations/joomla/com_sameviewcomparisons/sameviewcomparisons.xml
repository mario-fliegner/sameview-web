<?xml version="1.0" encoding="utf-8"?>
<!--
	Filename must be exactly "sameviewcomparisons.xml" (the element with its
	"com_" prefix stripped), not e.g. "sameview_comparisons.xml": confirmed
	against a real Joomla 6.1.2 instance that the general installer accepts
	any *.xml with an <extension> root regardless of filename, but the core
	PSR-4 namespace-map generator (libraries/namespacemap.php
	JNamespacePsr4Map::getExtensions()) looks for this exact filename
	pattern only (falling back to "<full element>.xml") — a mismatch here
	silently leaves the component's own namespace unregistered, causing a
	"Class ... not found" fatal error the first time the component is
	actually opened, well after a successful-looking install.

	method="upgrade" is required here: without it, Joomla's own
	Installer\Adapter\ComponentAdapter::checkExtensionInFilesystem() aborts
	("Another component is already using folder: ...") the moment this
	component is reinstalled while its target directory already exists on
	disk — regardless of whether a matching #__extensions row exists —
	leaving no native way to deliver a code update through the ordinary
	Extensions Manager (docs/IMPLEMENTATION_PLAN_V1.md Phase 22 update-
	lifecycle fix; confirmed empirically against a real Joomla 6.1.2
	instance, both before and after this change).

	Confirmed empirically that method="upgrade" does NOT affect a genuinely
	fresh install: checkExtensionInFilesystem()'s whole upgrade-detection
	branch is itself gated behind the target directory already existing on
	disk, so on a clean site (nothing installed yet) the route stays
	'install' and <install><sql> still runs, unaffected by this attribute.
	The one confirmed edge case: if the target directory exists on disk but
	no matching #__extensions row does (e.g. a previously interrupted
	install/uninstall), Joomla still forces the update route here — which
	is why Com_SameviewcomparisonsInstallerScript::update() re-runs the same
	idempotent (CREATE TABLE IF NOT EXISTS) install SQL rather than
	assuming the table already exists.
-->
<extension method="upgrade" type="component">
	<name>COM_SAMEVIEWCOMPARISONS</name>
	<author>SameView</author>
	<creationDate>2026-08-14</creationDate>
	<copyright>Copyright SameView</copyright>
	<license>See LICENSE</license>
	<version>0.2.0</version>
	<description>COM_SAMEVIEWCOMPARISONS_XML_DESCRIPTION</description>
	<namespace path="src">Joomla\Component\Sameviewcomparisons</namespace>

	<install>
		<sql>
			<!--
				Confirmed against a real Joomla 6.1.2 instance:
				Installer::parseSQLFiles() only matches charset="utf8"
				literally (strtolower(...) === 'utf8') — charset="utf8mb4"
				makes it silently skip the file, no error. The driver
				attribute accepts "mysql" or "mysqli" equivalently (both
				normalize to the same internal value), but charset must be
				exactly "utf8" here regardless of the table's own actual
				charset, which the .sql file below still correctly declares
				as utf8mb4.
			-->
			<file driver="mysqli" charset="utf8">sql/install.mysqli.utf8.sql</file>
		</sql>
	</install>

	<scriptfile>script.php</scriptfile>

	<!--
		docs/IMPLEMENTATION_PLAN_V1.md Phase 22: the shared Embed runtime/CSS
		+ every Presentation Font's own file(s)/license, delivered through
		Joomla's own native Web Asset system
		(docs/JOOMLA_INTEGRATION.md "Frontend Delivery") rather than a
		manually enqueued <link>/<script>.

		The `js/` folder name and the `uri` value's own
		"com_sameviewcomparisons/..." prefix in media/joomla.asset.json are
		NOT arbitrary: confirmed against real Joomla 6.1.2 core source
		(Joomla\CMS\WebAsset\WebAssetItem::resolvePath() ->
		Joomla\CMS\HTML\HTMLHelper::mediaPath()/includeRelativeFiles()) that a
		script-type Web Asset's `uri` is resolved as
		"<first-path-segment>/js/<rest>" under `/media/`, regardless of the
		registry file's own folder — a plain path relative to this
		joomla.asset.json's own location (e.g. "embed/foo.js") is silently
		treated as belonging to a non-existent extension named "embed" and
		produces NO `<script>` tag at all, with no error of any kind (only
		discovered by comparing Joomla's own internal "active assets" list,
		which did include the entry, against the final rendered `<head>`,
		which did not — see this repository's own Phase 22 real-instance
		verification). `comparison-embed-runtime.js` and
		`comparison-embed.css` are therefore both placed under this
		component's own `js/` subfolder as plain sibling files (the runtime
		script derives its own CSS URL by replacing its own filename in the
		same directory — src/lib/comparison-embed-runtime-entry.ts — the CSS
		is never itself registered as a Web Asset, so Joomla's own
		type-based folder convention does not apply to it); `fonts/` is a
		sibling of `js/` (the pre-built CSS already assumes `../fonts/...`
		from its own location — scripts/build-presentation-runtime.mjs).
		`joomla.asset.json` itself is the one static, committed file here;
		comparison-embed-runtime.js, comparison-embed.css and every font file
		are injected only at generation time by
		src/lib/generate-joomla-package.ts (never committed as generated
		files inside this integration area, mirroring the WordPress
		integration's own Phase 16 Decision 72).
	-->
	<media destination="com_sameviewcomparisons" folder="media">
		<filename>joomla.asset.json</filename>
		<folder>js</folder>
		<folder>fonts</folder>
	</media>

	<administration>
		<menu>COM_SAMEVIEWCOMPARISONS</menu>
		<files folder="admin">
			<folder>services</folder>
			<folder>src</folder>
			<folder>sql</folder>
			<folder>tmpl</folder>
			<file>access.xml</file>
			<file>config.xml</file>
		</files>
		<languages folder="admin">
			<language tag="en-GB">language/en-GB/en-GB.com_sameviewcomparisons.ini</language>
			<language tag="en-GB">language/en-GB/en-GB.com_sameviewcomparisons.sys.ini</language>
			<language tag="de-DE">language/de-DE/de-DE.com_sameviewcomparisons.ini</language>
			<language tag="de-DE">language/de-DE/de-DE.com_sameviewcomparisons.sys.ini</language>
		</languages>
	</administration>
</extension>
