{
  "name": "sameview-web",
  "version": "0.0.1",
  "private": true,
  "main": "app.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); for (const p of ['dist','.astro']) fs.rmSync(p,{recursive:true,force:true})\"",
    "clean:all": "node -e \"const fs=require('node:fs'); for (const p of ['dist','.astro','node_modules']) fs.rmSync(p,{recursive:true,force:true})\"",
    "dev": "astro dev",
    "build": "astro build",
    "build:clean": "pnpm clean && pnpm build",
    "rebuild": "pnpm clean:all && pnpm install --frozen-lockfile && pnpm build",
    "preview": "astro preview",
    "start": "node app.js",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "biome check .",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.2",
    "@astrojs/react": "^6.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@zip.js/zip.js": "^2.8.34",
    "astro": "^7.1.3",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "^1.62.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  }
}